WITH yearly_sales AS (
  SELECT
    Year,
    SUM(Units) AS total_units,
    SUM(Annual_Total) AS total_sales
  FROM `automotive-analytics-505114.automotive_analytics.fact_brand_sales_final`
  GROUP BY Year
)

SELECT
  Year,
  total_units,
  total_sales,

  ROUND(
    (
      total_sales - LAG(total_sales) OVER(ORDER BY Year)
    )
    /
    LAG(total_sales) OVER(ORDER BY Year)
    * 100,
    2
  ) AS sales_growth_percentage

FROM yearly_sales
ORDER BY Year
