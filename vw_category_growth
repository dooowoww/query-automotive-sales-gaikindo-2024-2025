WITH yearly_sales AS (
  SELECT
    Category,
    Year,
    SUM(Units) AS Sales
  FROM `automotive-analytics-505114.automotive_analytics.fact_category_sales`
  WHERE Year IN (2024, 2025)
  GROUP BY
    Category,
    Year
),

growth AS (
  SELECT
    Category,
    Year,
    Sales,
    Sales - LAG(Sales) OVER (
      PARTITION BY Category
      ORDER BY Year
    ) AS Sales_Growth,
    SAFE_DIVIDE(
      Sales - LAG(Sales) OVER (
        PARTITION BY Category
        ORDER BY Year
      ),
      LAG(Sales) OVER (
        PARTITION BY Category
        ORDER BY Year
      )
    ) * 100 AS YoY_Growth_Pct
  FROM yearly_sales
)

SELECT
  Category,
  Year,
  Sales,
  Sales_Growth,
  YoY_Growth_Pct
FROM growth
ORDER BY
  Year,
  Category
